# ---------------------------------------------------------------------------
# Tools Jamaica API — environment TEMPLATE
# Copy to `.env` (git-ignored) and fill in. NEVER put real secrets in this file.
# The server zod-validates `.env` at boot and refuses to start if misconfigured
# (see src/config/env.ts).
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-only secret, NEVER shipped to the client
SUPABASE_ANON_KEY=              # server-only; used for GoTrue auth calls
SUPABASE_JWT_SECRET=            # HS256 legacy secret (only if project signs HS256)

# Signs the session cookies (long random string, e.g. `openssl rand -hex 32`)
COOKIE_SECRET=

# Production base URL (absolute URLs + secure/same-origin cookies). It is also
# the host of the emailed signup confirmation link, so in local development
# point it at the Vite dev server (http://localhost:5173) or the link will send
# you to production.
APP_BASE_URL=https://tools-jamaica-production.up.railway.app

# Dev-only CORS when running Vite separately (unset in production).
WEB_ORIGIN=http://localhost:5173

# Machine-to-machine key for /api/v1/agent (e.g. the n8n WhatsApp agent's
# SearchProducts tool). Min 32 chars, e.g. `openssl rand -hex 32`. Leave unset
# to keep the route disabled (it 404s, fail-closed, rather than opening).
AGENT_API_KEY=

# Transactional email (signup confirmation links), sent via the Resend REST API.
# Leave both unset in development: lib/email.ts then LOGS the confirmation link
# to the API console instead of sending, so the whole signup flow is testable
# without a verified domain. In production an unset key is a hard error.
# Note: Resend's shared `onboarding@resend.dev` sender only delivers to the
# Resend account owner's own address — real signups need a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Tools Jamaica <onboarding@resend.dev>
